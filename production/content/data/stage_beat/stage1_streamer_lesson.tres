[gd_resource type="Resource" script_class="StageBeatDefinition" load_steps=5 format=3]
[ext_resource type="Script" path="res://production/content/definitions/stage_beat_definition.gd" id="1"]
[ext_resource type="Resource" path="res://production/content/data/segment/standard_combat.tres" id="2"]
[ext_resource type="Resource" path="res://production/content/data/encounter_variant/frontier_streamer.tres" id="3"]
[ext_resource type="Resource" path="res://production/content/data/stage_prop/frontier_planet_pass.tres" id="4"]
[resource]
script = ExtResource("1")
stable_id = &"stage1.streamer_lesson"
label = "Streaming Lesson"
start_seconds = 15.0
target_duration_seconds = 40.0
segment = ExtResource("2")
next_beat_ids = Array[StringName]([&"stage1.flanker_repeat"])
landmarks = Array[ExtResource("4")]([ExtResource("4")])
encounter_variants = Array[ExtResource("3")]([ExtResource("3")])
background_zone = &"planet_horizon"
music_state = &"frontier_teach"
practice_id = &"practice.stage1.streamer_lesson"
variation_ids = Array[StringName]([&"left_herd", &"right_herd"])
pressure = {"enemy_cap": 5, "projectile_cap": 180, "speed_multiplier": 1.0, "high_attention_roles": 1}
