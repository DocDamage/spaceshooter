script = ExtResource("1")
stable_id = &"dialogue.boss_corsair_intro"
display_name = "Corsair Dreadnought Contact"
context = "pre_boss"
priority = 10
lines = Array[Dictionary]([{"speaker": "Command", "text": "Command hull ahead. Its outer weapons feed the main battery—strip them before the breach phase."}, {"speaker": "Corsair", "text": "Patrol craft, you crossed a frontier that no longer belongs to you."}])
