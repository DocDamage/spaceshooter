lines = Array[Dictionary]([{"speaker": "Kael", "text": "The command carrier is opening its wings. Destroy the gatekeeper, then breach the reactor before it jumps."}, {"speaker": "Nova", "text": "Frontier Shield, all ships forward."}, {"speaker": "Command", "text": "Carrier destroyed. The frontier is secure, but its route points beyond our charts."}])
