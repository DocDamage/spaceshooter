[ext_resource type="Script" path="res://production/content/definitions/codex_entry_definition.gd" id="1"]

[resource]
script = ExtResource("1")
stable_id = &"codex.location.frontier_lane"
display_name = "The Frontier Lane"
category = "locations"
body = "A sparse convoy route beyond the defended core systems. Its scattered planets conceal approach vectors, but leave civilian traffic exposed to fast raider screens. Command keeps only a thin patrol here—until First Contact changes the calculation."
unlock_rule = {}
