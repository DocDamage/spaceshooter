script = ExtResource("1")
stable_id = &"codex.technology.focus_drive"
display_name = "Focus Drive"
category = "technology"
body = "Focus mode reduces translational speed to make small corrections around the fighter's true collision body. It is a control discipline, not a defensive bonus: shields, armor, and damage remain unchanged."
